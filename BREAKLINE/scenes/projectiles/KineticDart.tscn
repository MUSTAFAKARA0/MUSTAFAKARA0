[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/projectiles/Projectile.gd" id="1_script"]

; KINETIC DART
;
; Read priority, front to back: a DARK SOLID SPEAR (nose + body) carrying a
; bright ENERGY BAND and a bright FOUR-FIN CROSS at the tail. The shell is
; deliberately NOT emissive: if the whole dart glows it collapses into a
; bright blob at speed, which is exactly the orb silhouette this replaces.
; Dark shell + lit accents keeps the pointed shape and the fin cross
; legible, and lets the dart's own OmniLight3D actually shade it as it
; passes structural geometry.
;
; No triplanar/noise material here on purpose -- the dart is small,
; fast, and never inspected up close, so a plain metal shell is the right
; cost. The noise-textured metal is reserved for structures the player
; stands next to (see assets/materials/structural_metal.tres).

[sub_resource type="CylinderMesh" id="CylinderMesh_nose"]
top_radius = 0.0
bottom_radius = 0.072
height = 0.3
radial_segments = 8
rings = 1

[sub_resource type="CylinderMesh" id="CylinderMesh_body"]
top_radius = 0.072
bottom_radius = 0.072
height = 0.36
radial_segments = 8
rings = 1

[sub_resource type="CylinderMesh" id="CylinderMesh_band"]
top_radius = 0.086
bottom_radius = 0.086
height = 0.07
radial_segments = 8
rings = 1

[sub_resource type="BoxMesh" id="BoxMesh_fin"]
size = Vector3(0.04, 0.2, 0.014)

; Dark metal shell -- the silhouette carrier.
[sub_resource type="StandardMaterial3D" id="Material_shell"]
albedo_color = Color(0.105, 0.12, 0.145, 1)
metallic = 0.9
metallic_specular = 0.6
roughness = 0.28

; Energy band + fins. Unshaded so they hold a constant readable brightness
; at any distance, but at ~2.2 rather than the 5.0 they used to run at:
; the old value bloomed into a smear and hid the fin shape it was meant
; to show.
[sub_resource type="StandardMaterial3D" id="Material_energy"]
shading_mode = 0
albedo_color = Color(0.48, 0.94, 1, 1)

[sub_resource type="StandardMaterial3D" id="Material_fin"]
shading_mode = 0
albedo_color = Color(0.36, 0.82, 1, 1)

[sub_resource type="SphereShape3D" id="Shape_core"]
radius = 0.14

[sub_resource type="QuadMesh" id="QuadMesh_trail"]
size = Vector2(0.07, 0.3)

[sub_resource type="StandardMaterial3D" id="Material_trail"]
shading_mode = 0
transparency = 1
albedo_color = Color(0.42, 0.9, 1, 0.42)
billboard_mode = 1
billboard_keep_scale = true

[node name="KineticDart" type="Area3D"]
collision_layer = 16
collision_mask = 68
monitoring = false
monitorable = false
script = ExtResource("1_script")

