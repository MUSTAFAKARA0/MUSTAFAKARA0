[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/obstacles/Obstacle.gd" id="1_script"]
[ext_resource type="ShaderMaterial" path="res://assets/materials/danger_material.tres" id="2_danger"]

; ObstacleWall is now ONE mesh. The two WarningStripe boxes it used to
; carry were sitting 0.01 in front of the body (z-fighting risk) and,
; worse, all pooled obstacles shared the same stripe material sub-resource
; -- so the per-instance pulse in Obstacle.gd was in fact writing to one
; shared material and every obstacle on screen pulsed in lockstep. The
; stripes are generated in assets/materials/shaders/hazard_stripe.gdshader
; instead, and Obstacle.gd owns a duplicate per instance.

[sub_resource type="BoxMesh" id="BoxMesh_wall"]
size = Vector3(1.9, 2.6, 0.4)

[sub_resource type="BoxShape3D" id="Shape_wall"]
size = Vector3(1.9, 2.6, 0.4)

