[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/HUD.gd" id="1_script"]

; HUD -- consistency pass against the FRACTURE PROTOCOL art direction.
; This is NOT the UI overhaul (see docs/UI_DIRECTION.md for what that
; still needs: a real typeface, a spacing scale, panel/icon language and
; a proper safe-area system). Three things were actively fighting the art
; direction and are fixed here:
;
;   1. The crosshair was pure white. White is not in the palette, and a
;      white crosshair sits at the exact centre of the screen -- the one
;      pixel the player looks at most -- reading as a brighter gameplay
;      signal than the targets it is aimed at. It is now palette cyan at
;      lower alpha, backed by a dark arm so it survives being dragged
;      across a bright emissive surface.
;   2. Labels had no outline. Over the energy conduits and the hazard
;      stripes they would have dropped out entirely. Every label now
;      carries a dark outline -- cheaper and more robust at phone size
;      than a panel behind the text.
;   3. The combo label used the same cyan as a target core. Combo is a
;      REWARD signal, and the colour contract gives reward to gold, so it
;      now shares the coin colour instead of competing with gameplay.

[node name="HUD" type="Control"]
layout_mode = 3
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1_script")

