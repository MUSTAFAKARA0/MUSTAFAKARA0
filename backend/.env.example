# Copy this file to .env and adjust as needed. All variables are optional --
# sensible defaults are used otherwise. See app/config.py.

# PTS_DATA_DIR=data
# PTS_UPLOAD_TTL_MINUTES=120
# PTS_ALLOWED_ORIGINS=["http://localhost:5173"]
# PTS_MAX_UPLOAD_FILES=6
# PTS_MAX_UPLOAD_MB=25

# Optional commercial Image-to-3D providers (NOT required -- the app works
# fully with the built-in local geometric providers without any of these).
# Adding a key here does not enable a provider by itself; see
# app/pipeline/reconstruction/registry.py and README "Roadmap".
# PTS_TRIPO_API_KEY=
# PTS_MESHY_API_KEY=
# PTS_RODIN_API_KEY=
# PTS_STABILITY_API_KEY=
