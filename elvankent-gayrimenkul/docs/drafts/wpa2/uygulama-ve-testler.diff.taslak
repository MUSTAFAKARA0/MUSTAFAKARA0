diff --git a/elvankent-gayrimenkul/src/app/actions/media.ts b/elvankent-gayrimenkul/src/app/actions/media.ts
index d659514..2d8d885 100644
--- a/elvankent-gayrimenkul/src/app/actions/media.ts
+++ b/elvankent-gayrimenkul/src/app/actions/media.ts
@@ -198,6 +198,11 @@ export async function renewMediaUpload(mediaId: string): Promise<ActionResult<Up
   });
 }
 
+/** RPC eski veritabanında yok: PostgREST PGRST202 (şema önbelleğinde yok) ya da Postgres 42883 */
+function isMissingRpc(error: { code?: string; message?: string }) {
+  return error.code === 'PGRST202' || error.code === '42883' || /could not find the function/i.test(error.message ?? '');
+}
+
 async function markFailed(ctx: OrgContext, mediaId: string, message: string) {
   await ctx.supabase.from('media_assets').update({ status: 'failed', error: message.slice(0, 300) }).eq('id', mediaId);
 }
@@ -263,7 +268,6 @@ async function processMedia(ctx: OrgContext, media: AdminMedia & { original_path
       width: processed.width,
       height: processed.height,
       blur_data_url: processed.blurDataUrl,
-      variants_byte_size: processed.variantsBytes,
       processed_at: new Date().toISOString(),
       error: null,
     })
@@ -276,6 +280,35 @@ async function processMedia(ctx: OrgContext, media: AdminMedia & { original_path
     throw new ActionError('Fotoğraf kaydedilemedi. Lütfen tekrar deneyin.');
   }
 
+  // Gerçek boyutlar veritabanında (storage.objects) kaydedilir ve kota yeniden denetlenir. byte_size /
+  // variants_byte_size'ı oturum istemcisi doğrudan yazamaz (media_size_readonly), yalnızca bu RPC yazar.
+  const { error: sizeError } = await ctx.supabase.rpc('media_record_sizes', { p_media: media.id });
+  if (sizeError) {
+    if (isMissingRpc(sizeError)) {
+      // Eski veritabanı (bekleyen migration uygulanmamış): önceki davranış, varyant boyutu doğrudan yazılır
+      const { error: legacyError } = await ctx.supabase
+        .from('media_assets')
+        .update({ variants_byte_size: processed.variantsBytes })
+        .eq('id', media.id);
+      if (legacyError) {
+        await ctx.supabase.storage.from(MEDIA_BUCKETS.public).remove(variantPaths(publicBase, widths));
+        assertNoDbError(legacyError);
+      }
+    } else if (/plan_limit_storage/.test(sizeError.message ?? '') && media.status === 'ready') {
+      // Hazır fotoğrafın yeniden işlenmesi (döndürme): satır yeni varyantları gösteriyor; orijinal ve varyantlar
+      // silinmez (veri kaybı olmaz), boyutlar önceki sürümün değerinde kalır. Kota yalnızca büyümede aşılabilir.
+      console.warn('[media] yeniden işleme kota üstünde; boyutlar güncellenmedi', media.id);
+    } else if (/plan_limit_storage/.test(sizeError.message ?? '')) {
+      await ctx.supabase.storage.from(MEDIA_BUCKETS.public).remove(variantPaths(publicBase, widths));
+      await ctx.supabase.storage.from(MEDIA_BUCKETS.originals).remove([media.original_path]);
+      await markFailed(ctx, media.id, 'Depolama kotası doldu.');
+      throw new ActionError('Depolama alanı kotanız doldu. Kullanılmayan fotoğrafları silin veya planınızı yükseltin.', 'quota');
+    } else {
+      await ctx.supabase.storage.from(MEDIA_BUCKETS.public).remove(variantPaths(publicBase, widths));
+      assertNoDbError(sizeError);
+    }
+  }
+
   // Önceki sürümün varyantları (döndürme / yeniden işleme)
   if (media.public_base && media.public_base !== publicBase && !media.public_base.startsWith('/')) {
     await ctx.supabase.storage.from(MEDIA_BUCKETS.public).remove(variantPaths(media.public_base, media.variant_widths ?? []));
