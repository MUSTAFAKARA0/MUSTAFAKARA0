# =============================================================================
# KARAY — Ortam değişkenleri (V2 + Stage 3)
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# .env.local git'e EKLENMEZ. Vercel'de aynı değerleri Project Settings >
# Environment Variables bölümüne girin.
#
# KURAL: "NEXT_PUBLIC_" ile başlayan değerler tarayıcıya gider. Gizli değerler
# (service role, salt, cron secret, harita API anahtarı) ASLA bu önekle
# tanımlanmaz.
# =============================================================================

# --- Supabase (Project Settings > API) ------------------------------------------
# Herkese açık (tarayıcıya gider). Veri güvenliği veritabanındaki RLS ile sağlanır.
NEXT_PUBLIC_SUPABASE_URL=https://PROJE-KODUNUZ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GİZLİ — sadece sunucu. Form kayıtları, olay sayaçları, kullanıcı oluşturma,
# zamanlanmış temizlik ve yönetim betikleri için gerekir.
SUPABASE_SERVICE_ROLE_KEY=

# İsteğe bağlı: büyük dosya yüklemeleri için doğrudan depolama adresi.
# Boşsa https://PROJE-KODUNUZ.storage.supabase.co otomatik türetilir.
# NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# --- Ortam (Stage 3) -------------------------------------------------------------
# production | demo | preview | development
# production DIŞINDAKİ her ortam arama motorlarına kapalıdır (X-Robots-Tag: noindex,
# meta robots noindex). demo/preview'da sitede "DEMO ORTAMI" şeridi görünür.
# Boş bırakılırsa Vercel'in VERCEL_ENV değeri kullanılır (production → production,
# preview → preview). Demo projesi için mutlaka SITE_ENV=demo tanımlayın.
# Build sırasında okunur: değiştirdikten sonra yeniden dağıtın (Vercel › Redeploy).
SITE_ENV=

# --- Site ve kiracılar (multi-tenant) -------------------------------------------
# Varsayılan kiracının kanonik adresi (sonunda / olmadan). SEO, site haritası ve
# paylaşım bağlantıları için.
NEXT_PUBLIC_SITE_URL=https://ornekemlak.com

# İsteğe bağlı: bilinmeyen alan adlarında, localhost'ta ve *.vercel.app önizlemelerinde
# gösterilecek kiracının kısa adı (organizations.slug). Tanımlı değilse veritabanında
# varsayılan olarak işaretli kiracı (organizations.is_default) kullanılır. Kodda hiçbir
# kiracının adı yazılı değildir.
# DEFAULT_TENANT_SLUG=

# İsteğe bağlı (SaaS): ofislerin alt alan adları için kök alan adı.
# Ör. platform.com → ofis1.platform.com. Özel alan adları süper admin panelinden eklenir.
# PLATFORM_ROOT_DOMAIN=

# İsteğe bağlı: KARAY şirket sayfasının kendi alan adı(ları), virgülle (ör. karay.com.tr,www.karay.com.tr).
# Bu alan adlarında kök (/) doğrudan KARAY sayfasını açar. Tanımsızsa KARAY sayfası yalnızca
# platform/önizleme alan adlarında /karay yolunda açılır; kiracıların özel alan adlarında asla açılmaz.
# KARAY_HOSTS=

# --- Güvenlik --------------------------------------------------------------------
# GİZLİ — IP adreslerini geri döndürülemez şekilde özetlemek için rastgele uzun metin.
# Üretmek için: openssl rand -hex 32
IP_HASH_SALT=

# GİZLİ — Zamanlanmış görev (Vercel Cron: /api/cron/media-cleanup) doğrulaması.
# Vercel bu değeri "Authorization: Bearer <CRON_SECRET>" olarak otomatik gönderir.
# Üretmek için: openssl rand -hex 32
CRON_SECRET=

# --- Talep bildirimleri (Stage 3) ------------------------------------------------
# Yeni web talebinde ofise e-posta. EMAIL_PROVIDER: resend | log (yalnızca yerel) | none
# Resend: https://resend.com → alan adınızı ekleyin, verilen SPF (TXT), DKIM (TXT/CNAME)
# ve önerilen DMARC kaydını DNS'e girin; doğrulandıktan sonra API anahtarı oluşturun.
EMAIL_PROVIDER=none
# GİZLİ — Resend API anahtarı (re_...)
RESEND_API_KEY=
# Doğrulanmış alan adından gönderici, ör. Ofis Adı <bildirim@ornekemlak.com>
EMAIL_FROM=
# İsteğe bağlı yanıt adresi, ör. info@ornekemlak.com
EMAIL_REPLY_TO=
# minimal (varsayılan): e-postada kişisel veri YOK (tür, ilan, saat, panel bağlantısı).
# full: ad, telefon, e-posta ve mesaj da yazılır — yurt dışındaki e-posta servisine kişisel
# veri aktarımı olduğundan HUKUKÇU ONAYINDAN SONRA açın (docs/LEGAL_DATA_MAP.md).
NOTIFY_EMAIL_DETAILS=minimal

# --- Hata izleme ve performans (Stage 3) ------------------------------------------
# Hatalar her durumda tek satır JSON olarak loglanır (Vercel › Logs). İsteğe bağlı iletim:
# GİZLİ SAYILIR — Sentry projesinin DSN değeri (Settings › Client Keys)
SENTRY_DSN=
# GİZLİ — Slack/Discord gelen webhook adresi ({ text } alanını gösterir)
ERROR_WEBHOOK_URL=
# Vercel Speed Insights ve Web Analytics Vercel'de otomatik çalışır (Vercel panelinden
# proje için etkinleştirin). Uptime izleme: https://ALANADI/api/health

# --- Yönetici güvenliği (Stage 3) -------------------------------------------------
# true: süper admin hesaplarında iki adımlı doğrulama (TOTP) zorunlu
PLATFORM_ADMIN_MFA_REQUIRED=false

# --- Özel alan adı otomasyonu (Stage 3, isteğe bağlı) -----------------------------
# manual (varsayılan): alan adı panelden eklenir, DNS kaydı ve Vercel'e ekleme elle yapılır.
# vercel: platformdan eklenen alan adı Vercel projesine API ile otomatik eklenir/kaldırılır.
DOMAIN_PROVIDER=manual
# GİZLİ — Vercel › Account Settings › Tokens (yalnızca bu proje/ekip kapsamlı token önerilir)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- SEO (isteğe bağlı) ----------------------------------------------------------
# Google Search Console doğrulama kodu. Her ofis kendi kodunu Yönetim > SEO
# ekranından girebilir; bu değer yalnızca yedek olarak kullanılır.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Harita (sunucuda kalır; döşemeler /api/tiles üzerinden sunulur) -------------
# MAP_PROVIDER: osm (varsayılan) | maptiler | stadia | mapbox | custom
# Canlı ticari kullanım için anahtarlı bir sağlayıcı önerilir (MapTiler veya Stadia Maps):
# OpenStreetMap'in ücretsiz döşeme sunucusu yoğun/ticari kullanım için tasarlanmamıştır.
MAP_PROVIDER=osm
# GİZLİ — maptiler/stadia/mapbox API anahtarı (tarayıcıya gönderilmez)
MAP_API_KEY=
# İsteğe bağlı stil: maptiler → streets-v2, stadia → alidade_smooth, mapbox → mapbox/streets-v12
MAP_STYLE=
# custom sağlayıcı için döşeme şablonu, ör. https://ornek.com/{z}/{x}/{y}.png
MAP_TILE_URL=
# İsteğe bağlı atıf metni (HTML); boşsa sağlayıcının varsayılan atfı kullanılır
MAP_ATTRIBUTION=

# --- Yalnızca yerel geliştirme ---------------------------------------------------
# localhost üzerindeki Supabase görsellerinin optimizasyonuna izin verir. Canlıda TANIMLAMAYIN.
# NEXT_IMAGE_ALLOW_LOCAL_IP=1

# Yalnızca "npm run db:types" (TypeScript tip üretimi) için. Vercel'e EKLEMEYİN.
# DATABASE_URL=postgresql://postgres:SIFRE@db.PROJE-KODUNUZ.supabase.co:5432/postgres

# --- Testler (isteğe bağlı) -------------------------------------------------------
# Güvenlik testleri (npm run test:rls) yukarıdaki Supabase anahtarlarını kullanır;
# kendi geçici test ofislerini oluşturup siler. Canlı veritabanında çalıştırmadan önce yedek alın.
# E2E testleri (npm run test:e2e):
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_CHROMIUM_PATH=
