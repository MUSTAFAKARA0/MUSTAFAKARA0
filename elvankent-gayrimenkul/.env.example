# =============================================================================
# Elvankent Gayrimenkul — Ortam değişkenleri (V2)
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# .env.local git'e EKLENMEZ. Vercel'de aynı değerleri Project Settings >
# Environment Variables bölümüne girin.
#
# KURAL: "NEXT_PUBLIC_" ile başlayan değerler tarayıcıya gider. Gizli değerler
# (service role, salt, cron secret, harita API anahtarı) ASLA bu önekle
# tanımlanmaz.
# =============================================================================

# --- Supabase (Project Settings > API) ------------------------------------------
# Herkese açık (tarayıcıya gider). Veri güvenliği veritabanındaki RLS ile sağlanır.
NEXT_PUBLIC_SUPABASE_URL=https://PROJE-KODUNUZ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GİZLİ — sadece sunucu. Form kayıtları, olay sayaçları, kullanıcı oluşturma,
# zamanlanmış temizlik ve yönetim betikleri için gerekir.
SUPABASE_SERVICE_ROLE_KEY=

# İsteğe bağlı: büyük dosya yüklemeleri için doğrudan depolama adresi.
# Boşsa https://PROJE-KODUNUZ.storage.supabase.co otomatik türetilir.
# NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# --- Site ve kiracılar (multi-tenant) -------------------------------------------
# Varsayılan kiracının kanonik adresi (sonunda / olmadan). SEO, site haritası ve
# paylaşım bağlantıları için.
NEXT_PUBLIC_SITE_URL=https://elvankentgayrimenkul.com

# Bilinmeyen alan adlarında, localhost'ta ve *.vercel.app önizlemelerinde
# gösterilecek kiracının kısa adı (organizations.slug).
DEFAULT_TENANT_SLUG=elvankent

# İsteğe bağlı (SaaS): ofislerin alt alan adları için kök alan adı.
# Ör. platform.com → ofis1.platform.com. Özel alan adları süper admin panelinden eklenir.
# PLATFORM_ROOT_DOMAIN=

# --- Güvenlik --------------------------------------------------------------------
# GİZLİ — IP adreslerini geri döndürülemez şekilde özetlemek için rastgele uzun metin.
# Üretmek için: openssl rand -hex 32
IP_HASH_SALT=

# GİZLİ — Zamanlanmış görev (Vercel Cron: /api/cron/media-cleanup) doğrulaması.
# Vercel bu değeri "Authorization: Bearer <CRON_SECRET>" olarak otomatik gönderir.
# Üretmek için: openssl rand -hex 32
CRON_SECRET=

# --- SEO (isteğe bağlı) ----------------------------------------------------------
# Google Search Console doğrulama kodu. Her ofis kendi kodunu Yönetim > SEO
# ekranından girebilir; bu değer yalnızca yedek olarak kullanılır.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Harita (sunucuda kalır; döşemeler /api/tiles üzerinden sunulur) -------------
# MAP_PROVIDER: osm (varsayılan) | maptiler | mapbox | custom
# Yoğun trafikte OpenStreetMap'in kullanım politikası gereği anahtarlı bir sağlayıcı önerilir.
MAP_PROVIDER=osm
# GİZLİ — maptiler/mapbox API anahtarı (tarayıcıya gönderilmez)
MAP_API_KEY=
# İsteğe bağlı stil: maptiler → streets-v2, mapbox → mapbox/streets-v12
MAP_STYLE=
# custom sağlayıcı için döşeme şablonu, ör. https://ornek.com/{z}/{x}/{y}.png
MAP_TILE_URL=
# İsteğe bağlı atıf metni (HTML); boşsa sağlayıcının varsayılan atfı kullanılır
MAP_ATTRIBUTION=

# --- Yalnızca yerel geliştirme ---------------------------------------------------
# localhost üzerindeki Supabase görsellerinin optimizasyonuna izin verir. Canlıda TANIMLAMAYIN.
# NEXT_IMAGE_ALLOW_LOCAL_IP=1

# Yalnızca "npm run db:types" (TypeScript tip üretimi) için. Vercel'e EKLEMEYİN.
# DATABASE_URL=postgresql://postgres:SIFRE@db.PROJE-KODUNUZ.supabase.co:5432/postgres

# --- Testler (isteğe bağlı) -------------------------------------------------------
# Güvenlik testleri (npm run test:rls) yukarıdaki Supabase anahtarlarını kullanır;
# kendi geçici test ofislerini oluşturup siler. Canlı veritabanında çalıştırmadan önce yedek alın.
# E2E testleri (npm run test:e2e):
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_CHROMIUM_PATH=
