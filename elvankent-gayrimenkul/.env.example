# =============================================================================
# Elvankent Gayrimenkul — Ortam değişkenleri
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# .env.local git'e EKLENMEZ. Vercel'de aynı değerleri Project Settings >
# Environment Variables bölümüne girin.
# =============================================================================

# --- Supabase (Project Settings > API) ------------------------------------------
# Herkese açık (tarayıcıya gider). Güvenlik RLS politikalarıyla sağlanır.
NEXT_PUBLIC_SUPABASE_URL=https://PROJE-KODUNUZ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GİZLİ — sadece sunucu. Asla NEXT_PUBLIC_ öneki ile tanımlamayın, paylaşmayın.
# İletişim formu kaydı ve ilan istatistikleri için gereklidir.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------------
# Kanonik adres (sonunda / olmadan). SEO, sitemap ve paylaşım bağlantıları için.
NEXT_PUBLIC_SITE_URL=https://elvankentgayrimenkul.com

# GİZLİ — IP adreslerini geri döndürülemez şekilde özetlemek için rastgele uzun bir metin.
# Üretmek için: openssl rand -hex 32
IP_HASH_SALT=

# --- İsteğe bağlı ----------------------------------------------------------------
# Google Search Console HTML etiketi doğrulama kodu (content="..." içindeki değer)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Harita döşeme adresi (sunucuda kalır, tarayıcıya gitmez). Boşsa OpenStreetMap kullanılır.
# Yoğun trafikte ücretli/anahtarlı bir sağlayıcı önerilir, ör. MapTiler:
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=GIZLI_ANAHTAR
MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Sadece yerel geliştirme: localhost üzerindeki Supabase görsellerinin optimizasyonuna izin verir.
# Canlı ortamda TANIMLAMAYIN.
# NEXT_IMAGE_ALLOW_LOCAL_IP=1

# --- Testler (isteğe bağlı) ----------------------------------------------------
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
